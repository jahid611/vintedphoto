# --- Supabase ---------------------------------------------------------------
# Sans ces variables, Dripshot tourne en mode démo : le solde de crédits vit
# dans le navigateur. Suffisant pour développer, jamais pour encaisser.
# Projet → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service_role : serveur uniquement, jamais préfixée NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe -----------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Détourage --------------------------------------------------------------
# Par défaut le modèle est tiré du CDN de @imgly. Renseigne une URL pour
# l'héberger toi-même (réseau d'entreprise, offline, ou simplement pour ne pas
# dépendre d'un tiers).
NEXT_PUBLIC_BG_REMOVAL_PATH=
