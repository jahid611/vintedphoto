# --- Supabase ---------------------------------------------------------------
# Sans ces variables, Dripshot tourne en mode démo : le solde de crédits vit
# dans le navigateur. Suffisant pour développer, jamais pour encaisser.
# Dashboard → Settings → API keys
NEXT_PUBLIC_SUPABASE_URL=
# Le dashboard affiche aujourd'hui une « clé publiable » (sb_publishable_...) ;
# les anciens projets ont une clé « anon ». Les deux vont dans cette variable.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé secrète / service_role : serveur uniquement, jamais préfixée NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe -----------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Détourage --------------------------------------------------------------
# Par défaut le modèle est tiré du CDN de @imgly. Renseigne une URL pour
# l'héberger toi-même (réseau d'entreprise, offline, ou simplement pour ne pas
# dépendre d'un tiers).
NEXT_PUBLIC_BG_REMOVAL_PATH=
